# Copy to .env and adjust if needed. Defaults already match the values used
# throughout this stack, so an untouched .env works out of the box.

ANVIL_PORT=8545

# Host port for Postgres defaults to 55432 (not 5432) so this stack can run
# next to a host Postgres already listening on 5432 without stopping it. The
# container's own Postgres always listens on 5432 internally; connect from
# the host with postgres://agora:agora@localhost:55432/<db>.
POSTGRES_PORT=55432
POSTGRES_USER=agora
POSTGRES_PASSWORD=agora
POSTGRES_DB=postgres

# DAO Node. TOKEN_ADDRESS, GOVERNOR_ADDRESS and DAO_NODE_START_BLOCK are
# written by Task 6's deployment script from the Part 1 manifest at
# deployments/31337/latest.json; the placeholders below only let the
# service boot before a fleet has been deployed.
DAO_NODE_PORT=8000
CONTRACT_DEPLOYMENT=local
CHAIN_ID=31337
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
DAO_NODE_START_BLOCK=0

# How the governor's clock counts (EIP-6372). AgoraGovernor V2 answers
# `CLOCK_MODE()` with "mode=timestamp", so a proposal's start_block/end_block
# are unix timestamps; infra/blockcache-shim needs to know that to answer
# CPLS's timestamp and contract-call lookups. Set to "blocknumber" only for a
# block-numbered governor. See infra/blockcache-shim/server.py.
GOVERNOR_CLOCK_MODE=timestamp

# CPLS (Common Proposal Listing Service) and its archive store. CPLS writes
# gzipped NDJSON proposal archives to a GCS bucket; Agora Next's archive mode
# reads them back. infra/docker-compose.yml (the base file) targets real GCS
# with no emulator; GCS_BUCKET_NAME also names the bucket
# infra/scripts/create-fake-bucket.sh creates when using the local/offline
# overlay below.
CPLS_PORT=8001
GCS_BUCKET_NAME=fleet-archive-dev

# Real GCS credentials: a service account JSON key file path on the host.
# Required for the base compose file alone to boot cpls (it has no emulator
# fallback); not needed at all when layering infra/docker-compose.offline.yml
# on top (see below), since that overlay points cpls at a local fake-gcs
# instead.
# GCS_CREDENTIALS_FILE=/absolute/path/to/service-account.json

# Local/offline stand-in for GCS (no real credentials needed). Bring the
# stack up with both compose files layered so cpls talks to fake-gcs instead
# of real GCS:
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.offline.yml up -d
# then run infra/scripts/create-fake-bucket.sh. See
# infra/docker-compose.offline.yml and infra/scripts/create-fake-bucket.sh.
FAKE_GCS_PORT=4443

# Agora Next (Task 5), the fleet governance UI. Most of its many env vars
# are set directly in infra/docker-compose.yml's agora-next service
# (documented in full in infra/agora-next/.env.fleet.example) rather than
# read from this file, so a fresh checkout with no infra/.env at all still
# boots it; GCS_BUCKET_NAME above is reused for its archive bucket too.
# This is the one port it needs a host-side default for.
AGORA_NEXT_PORT=3000
