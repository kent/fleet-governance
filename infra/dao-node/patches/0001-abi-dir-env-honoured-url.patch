 from abifsm import ABI, ABISet
-os.environ['ABI_URL'] = 'https://storage.googleapis.com/agora-abis/v2'
+os.environ.setdefault('ABI_URL', 'https://storage.googleapis.com/agora-abis/v2')
+
+######################################################################
+#
+# When ABI_DIR is set and holds a file named <lowercase-address>.json for
+# a contract, load the ABI from disk instead of fetching it from the
+# internet. Falls back to ABI.from_internet(...) otherwise, preserving
+# upstream behaviour when ABI_DIR is unset or the file is missing.
+#
+######################################################################
+
+def load_abi(name, address, chain_id):
+    abi_dir = os.getenv('ABI_DIR', None)
+    if abi_dir:
+        abi_path = os.path.join(abi_dir, f"{address.lower()}.json")
+        if os.path.exists(abi_path):
+            logr.info(f"Loading ABI for {name} from {abi_path}")
+            return ABI.from_file(name, abi_path)
+    return ABI.from_internet(name, address, chain_id=chain_id, implementation=True)
 
 ######################################################################
