+def test_Proposals_agora_v2_missing_proposal_type_marker():
+    """
+    Regression test for patch 0002 (infra/dao-node/patches/0002-tolerate-missing-proposal-type-marker.patch).
+
+    Upstream at commit cb299a0 raises IndexError when an agora >= 2.0
+    proposal description has no '#proposalTypeId=' marker. The patched
+    code must tolerate that and default proposal_type to 0.
+    """
+    proposals = Proposals(governor_spec={'name': 'agora', 'version': 2.0})
+
+    event = {
+        'signature': PROPOSAL_CREATED_1,
+        'sighash': 'deadbeef',
+        'proposal_id': '999',
+        'block_number': 100,
+        'description': 'A proposal description with no type marker in it',
+    }
+
+    proposals.handle(event)
+
+    assert '999' in proposals.proposals
+    assert proposals.proposals['999'].proposal_type == 0
+    assert proposals.proposals['999'].create_event['proposal_type_id'] == 0
