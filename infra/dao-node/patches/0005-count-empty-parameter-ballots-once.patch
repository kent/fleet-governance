+def test_VoteAggregation_empty_encoded_params_are_counted_once():
+    """Fleet's castVoteWithReasonAndParams encodes an empty option list."""
+    from eth_abi import encode
+    agg = VoteAggregation(module_spec=None)
+    for index in range(5):
+        agg.tally({
+            'voter': f'0x{index:040x}', 'proposal_id': '1', 'support': 1,
+            'weight': 10**18, 'params': encode(['uint256[]'], [[]]).hex(),
+        })
+    assert agg.num_of_votes == 5
+    assert agg.totals()['no-param']['1'] == str(5 * 10**18)
+
+
+def test_VoteAggregation_empty_params_keep_opposing_and_abstaining_weights():
+    from eth_abi import encode
+    agg = VoteAggregation(module_spec=None)
+    for support in (0, 1, 2):
+        agg.tally({'support': support, 'weight': 17,
+                   'params': encode(['uint256[]'], [[]]).hex()})
+    assert agg.totals()['no-param'] == {'0': '17', '1': '17', '2': '17'}
