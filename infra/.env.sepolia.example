# Copy to infra/.env for a Base Sepolia read side. Every key here is documented in
# infra/.env.example; only the values differ. See docs/deployment-runbook.md.
#
# No offline overlay is used against Base Sepolia: bring the stack up with the base
# infra/docker-compose.yml only (no docker-compose.offline.yml), and set GCS_CREDENTIALS_FILE
# below to a real service account key. FAKE_GCS_PORT is omitted on purpose; it only matters when
# the offline overlay creates a local fake-gcs container.

ANVIL_PORT=8545

POSTGRES_PORT=55432
POSTGRES_USER=agora
POSTGRES_PASSWORD=agora
POSTGRES_DB=postgres

# DAO Node. TOKEN_ADDRESS, GOVERNOR_ADDRESS and DAO_NODE_START_BLOCK are written by
# `fleet readside --manifest deployments/84532/latest.json --restart`; the placeholders below
# only let the service boot before that has run once.
DAO_NODE_PORT=8000
CONTRACT_DEPLOYMENT=sepolia
CHAIN_ID=84532
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
DAO_NODE_START_BLOCK=0

# Chain endpoints. Replace with your Base Sepolia RPC provider's HTTP and WebSocket URLs. Never
# commit real values here; this file only ships placeholders.
DAO_NODE_ARCHIVE_NODE_HTTP=https://REPLACE_WITH_YOUR_RPC_PROVIDER/http
DAO_NODE_REALTIME_NODE_WS=wss://REPLACE_WITH_YOUR_RPC_PROVIDER/ws
# infra/blockcache-shim proxies to this URL for block timestamps and contract-call lookups.
# Point it at the same RPC provider's HTTP endpoint (infra/README.md, "Pointing at Base Sepolia").
ANVIL_RPC_URL=https://REPLACE_WITH_YOUR_RPC_PROVIDER/http

# dao-node client counts. NUM_POLLING_CLIENTS=0 is a local-Anvil-only workaround; on a real chain
# it must be 1, the backstop for websocket events a provider drops.
NUM_REALTIME_CLIENTS=1
NUM_POLLING_CLIENTS=1

# eth_getLogs range per archive backfill request. DAO Node already picks 2000 for chain id 84532
# (it is not in its own per-chain table); set it explicitly here to pin that value and to match
# your RPC provider's own eth_getLogs range cap if it is lower than 2000.
DAO_NODE_ARCHIVE_NODE_HTTP_BLOCK_COUNT_SPAN=2000

# AgoraGovernor V2 is timestamp-clocked (EIP-6372) on every chain, including Base Sepolia. Leave
# this at "timestamp"; do not switch to "blocknumber".
GOVERNOR_CLOCK_MODE=timestamp

# CPLS and its archive store. Real GCS only for Base Sepolia; no emulator.
CPLS_PORT=8001
GCS_BUCKET_NAME=REPLACE_WITH_YOUR_BUCKET_NAME

# Required for Base Sepolia: a service account JSON key file path on the host. This
# authenticates CPLS's writes only; the bucket (or its data/ prefix) must also be public-read for
# Agora Next's unauthenticated archive reads (infra/README.md, "The bucket must be publicly
# readable").
GCS_CREDENTIALS_FILE=/absolute/path/to/sepolia-service-account.json

# Agora Next.
AGORA_NEXT_PORT=3000

# Server-side RPC URL Agora Next uses for chain reads. One NEXT_PUBLIC_ value is inlined into
# both the server and the browser bundle; this is the server-correct value.
NEXT_PUBLIC_FORK_NODE_URL=https://REPLACE_WITH_YOUR_RPC_PROVIDER/http

# Replace before any deployment anyone else can reach: the literal in infra/.env.example is
# published in this repository. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_FRESH_SECRET_openssl_rand_-hex_32

# Memory cap for the agora-next container. Same value as local; raise it on a larger Docker VM.
AGORA_NEXT_MEM_LIMIT=6g
