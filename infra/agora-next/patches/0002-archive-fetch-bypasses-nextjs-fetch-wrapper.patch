# 0002: archive fetches use node:http/https, not Next.js's patched fetch
#
# src/lib/archiveUtils.ts's fetchArchiveNdjson/fetchArchiveGzipJson (the
# only two archive-object readers; every /proposals, /proposals/<id>,
# vote-history and delegates-archive read goes through one of them) used
# the global fetch() to read each gzipped object from the GCS bucket (or
# fake-gcs, offline), then decompressed with Node's zlib.gunzipSync
# server-side (isBrowser is false there). Server-side, every single one of
# these requests threw "TypeError: controller[kState].transformAlgorithm
# is not a function" on this Next.js version (confirmed: the exact same
# request, same URL, same response body, succeeds when made with plain
# node -e fetch(...) outside Next.js, so the bug is in Next's patched
# global fetch() used for its Data Cache/request-dedup instrumentation,
# not in this file's own logic or in the archive server's response). Every
# call site already wraps the eventual failure in a try/catch that quietly
# returns an empty list, so this never surfaced as a visible error: pages
# rendered 200 OK and simply showed no proposals, no votes, no delegates
# from the archive, with the real exception only visible in the server log.
#
# Fetching with node:http/node:https directly (server-side only; the
# browser has no such module and no browser session has hit this bug, so
# isBrowser still uses plain fetch()) has no such wrapper and works
# correctly. See docs/compatibility-notes.md, Task 6, "Agora Next's
# archive reads all fail silently: Next.js's patched fetch() cannot read
# a gzip response body server-side".
# Two behaviours this replacement must not lose relative to fetch():
#
#   * a request timeout. fetch() has none by default either, but Next.js's
#     wrapper and the platform both impose limits eventually; node:http
#     imposes none at all, so an archive host that accepts a connection and
#     then says nothing would hold every archive-reading page render open
#     forever. ARCHIVE_FETCH_TIMEOUT_MS (10 s) bounds it, and the failure
#     lands in the same catch every call site already has.
#   * redirects. fetch() follows them; node:http/https never do. A GCS
#     object read can answer 301/302 (a bucket in another location, or a
#     name served through a different host), and the redirect's empty body
#     would be gunzipped and read as "no data". One hop is followed; a
#     second is refused rather than chased, so a redirect loop cannot hang
#     a render either.
#
# Scope: this file is shared by every tenant, so this patch changes archive
# fetching for all of them, not only for fleet. That is deliberate. The
# behaviour it replaces was "every server-side archive read throws and is
# silently swallowed", which is broken for every tenant equally, and the
# replacement is strictly more conservative than the fetch() it stands in
# for (bounded time, at most one redirect). Recorded in
# docs/compatibility-notes.md, "Final review fixes".
#
--- a/src/lib/archiveUtils.ts
+++ b/src/lib/archiveUtils.ts
@@ -16,6 +16,111 @@
 
 const isBrowser = typeof window !== "undefined";
 
+/** How long a single server-side archive request may take before it is
+ * abandoned. Every call site treats a failure as "no data", so an archive
+ * host that hangs would otherwise stall a page render indefinitely. */
+const ARCHIVE_FETCH_TIMEOUT_MS = 10_000;
+
+/**
+ * Server-side fetch of a URL's raw bytes and status code, bypassing
+ * Next.js's patched global `fetch` (which wraps every fetch() call for its
+ * Data Cache/request-dedup instrumentation, even with `cache: "no-store"`).
+ * That wrapper's stream handling reliably threw `TypeError:
+ * controller[kState].transformAlgorithm is not a function` for every
+ * archive object fetched here specifically (reproduced directly against
+ * fake-gcs; the identical request succeeds outside Next.js, e.g. plain
+ * `node -e "fetch(...)"`, so the bug is in the wrapper, not in the
+ * archive server's response or in this function's own logic below,
+ * confirmed by this working). node:http/https have no such wrapper.
+ * Browser-side (isBrowser) still uses plain fetch(), since node:http is
+ * not available there and no browser session has hit this bug.
+ */
+async function fetchStatusAndBuffer(
+  url: string
+): Promise<{ status: number; statusText: string; buffer: ArrayBuffer }> {
+  if (isBrowser) {
+    const response = await fetch(url, { cache: "no-store" });
+    const buffer = await response.arrayBuffer();
+    return { status: response.status, statusText: response.statusText, buffer };
+  }
+
+  // Two separate dynamic imports, each with its own string literal
+  // specifier, not one import(expr) keyed on a runtime ternary: webpack
+  // (which also bundles this file's server code) can statically resolve
+  // each of these, but not a single call whose specifier is an
+  // expression, which it only warns about ("Critical dependency: the
+  // request of a dependency is an expression") rather than erroring on,
+  // silently leaving the dynamic-expression import broken in the
+  // Next.js server bundle at runtime (this file's archive fetches
+  // failed exactly this way when it originally reached this file as a
+  // single import(url.startsWith(...) ? "https" : "http")).
+  const httpModule = await import("http");
+  const httpsModule = await import("https");
+
+  const requestOnce = (
+    target: string,
+    redirectsLeft: number
+  ): Promise<{ status: number; statusText: string; buffer: ArrayBuffer }> =>
+    new Promise((resolve, reject) => {
+      const { get } = target.startsWith("https:") ? httpsModule : httpModule;
+
+      const request = get(target, (res) => {
+        const status = res.statusCode ?? 0;
+        const location = res.headers.location;
+
+        // node:http/https never follow redirects, unlike fetch(). A GCS
+        // object read can answer 301/302 (a bucket in another location,
+        // or a name served through a different host), and without this
+        // the redirect body, which is empty, would be gunzipped and
+        // treated as "no data". One hop only: a second is refused rather
+        // than chased, so a redirect loop can never hang a page render.
+        if (status >= 300 && status < 400 && location) {
+          res.resume();
+          if (redirectsLeft > 0) {
+            resolve(
+              requestOnce(new URL(location, target).toString(), redirectsLeft - 1)
+            );
+          } else {
+            reject(
+              new Error(`Too many redirects fetching archive data: ${target}`)
+            );
+          }
+          return;
+        }
+
+        const chunks: Buffer[] = [];
+        res.on("data", (chunk) => chunks.push(chunk));
+        res.on("end", () => {
+          const body = Buffer.concat(chunks);
+          resolve({
+            status,
+            statusText: res.statusMessage ?? "",
+            buffer: body.buffer.slice(
+              body.byteOffset,
+              body.byteOffset + body.byteLength
+            ),
+          });
+        });
+        res.on("error", reject);
+      });
+
+      // Without a timeout an unreachable or hanging archive host holds the
+      // request open for Node's default (no timeout at all), and every
+      // page that reads the archive waits with it. Applies to the whole
+      // request, connection included; fires on an idle socket.
+      request.setTimeout(ARCHIVE_FETCH_TIMEOUT_MS, () => {
+        request.destroy(
+          new Error(
+            `Archive fetch timed out after ${ARCHIVE_FETCH_TIMEOUT_MS}ms: ${target}`
+          )
+        );
+      });
+      request.on("error", reject);
+    });
+
+  return await requestOnce(url, 1);
+}
