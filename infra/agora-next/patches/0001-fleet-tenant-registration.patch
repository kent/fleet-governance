@@ -273,6 +274,12 @@
   demo4: ["dao-node"],
   demo3: ["dao-node"],
   shape: [],
+  // The fleet reads proposals from DAO Node (via CPLS's archive), like
+  // every other onchain-governor tenant here. Without this entry
+  // getParticipationSource() falls through to "none" and delegate
+  // participation renders empty; TENANT_PROPOSAL_SOURCES is typed
+  // Record<TenantNamespace, ...>, so omitting it is also a type error.
+  fleet: ["dao-node"],
 };
 
