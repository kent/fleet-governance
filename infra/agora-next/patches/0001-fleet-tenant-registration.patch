# 0001: register "fleet" as a tenant
#
# One-line registration edits to existing upstream files: new `case` arms
# keyed on the "fleet" namespace, the datasource schema list, and the
# TENANT_NAMESPACES entry itself. Everything that can live in a new file
# instead (the tenant's contracts/UI config, ABIs, Prisma views, assets)
# is in infra/agora-next/overlay/ rather than here. See
# docs/compatibility-notes.md, Task 5, for the exact edit points.
#
# TENANT_PROPOSAL_SOURCES (src/lib/constants.ts) was added in the final
# review fix wave, not with the rest: it was the one registration point
# missed. It is typed Record<TenantNamespace, readonly string[]>, so a
# missing "fleet" key is a type error (Next's dev server does not
# type-check, which is why nothing surfaced), and at runtime
# getParticipationSource() (src/lib/participation.ts line 12) falls back to
# [] and returns "none", so delegate participation renders empty on
# /delegates and on every delegate card. The fleet reads its proposals from
# DAO Node like every other onchain-governor tenant here. See
# docs/compatibility-notes.md, "Final review fixes".
#
diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index 98f7ba1..d7c8110 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -7,7 +7,7 @@ generator client {
 datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
-  schemas = ["agora", "alltenant", "boost", "config", "cyber", "derive", "ens", "etherfi", "optimism", "pguild", "retro_funding", "snapshot", "scroll", "syndicate", "uniswap", "xai", "b3", "demo", "linea", "towns", "demo2", "demo4", "demo3"]
+  schemas = ["agora", "alltenant", "boost", "config", "cyber", "derive", "ens", "etherfi", "optimism", "pguild", "retro_funding", "snapshot", "scroll", "syndicate", "uniswap", "xai", "b3", "demo", "linea", "towns", "demo2", "demo4", "demo3", "fleet"]
 }
 
