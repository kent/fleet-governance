# Reference for the fleet tenant's environment. infra/docker-compose.yml's
# agora-next service sets these directly (as environment:, not env_file:,
# so a missing copy of this file never breaks `docker compose up`, the same
# way anvil/postgres/dao-node/cpls tolerate a missing infra/.env). Copy this
# to infra/agora-next/.env.fleet for host-mode dev (see below) or as a
# reference when changing the compose service's environment: block.

# --- Critical tenant identity (README.md's "Critical Configuration") ---
NEXT_PUBLIC_AGORA_INSTANCE_NAME=fleet
NEXT_PUBLIC_AGORA_INSTANCE_TOKEN=FLEET
NEXT_PUBLIC_AGORA_ENV=dev
NEXT_PUBLIC_AGORA_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AGORA_API_KEY=dev

# --- RPC / chain ---
# vendor/agora-next/src/lib/rpcConfig.ts's getRpcUrlForChain() returns this
# verbatim whenever it is set, for every chain id, in preference to the
# Goldsky edge RPC + secret path. It is read with plain
# `process.env.NEXT_PUBLIC_FORK_NODE_URL` in several places (rpcConfig.ts,
# utils.ts, viem.ts, tenant.ts, the per-tenant contracts configs), never
# gated on typeof window, so Next.js inlines the SAME value into both the
# server bundle and the client (browser) bundle: there is no source-level
# way to give the server "http://anvil:8545" and the browser
# "http://localhost:8545" from one NEXT_PUBLIC_ var without a patch outside
# this task's registration-only scope. This value is set for the server
# side (SSR/API routes running inside the agora-next container need
# "anvil", the compose DNS name); a real browser hitting this tenant would
# need "http://localhost:8545" instead for any client-side chain read, and
# will not get it as configured here. See docs/compatibility-notes.md,
# Task 5, "NEXT_PUBLIC_FORK_NODE_URL: one value, two audiences" for the
# full writeup; this task's verification (curl against SSR pages) never
# executes browser JS, so it does not observe the gap.
NEXT_PUBLIC_FORK_NODE_URL=http://anvil:8545

# --- Database ---
# src/app/lib/prisma.ts reads only DATABASE_URL (prismaWeb2Client and
# prismaWeb3Client are the same PrismaClient instance); the two
# READ_*_DATABASE_URL_DEV vars below are documented in README.md but not
# actually read by the current code (see docs/compatibility-notes.md's
# earlier "Agora Next Prisma web2/web3 split" note from Task 2). Both are
# set anyway in case a future upstream version starts reading them.
DATABASE_URL=postgres://agora:agora@postgres:5432/agora_web3
READ_WRITE_WEB2_DATABASE_URL_DEV=postgres://agora:agora@postgres:5432/agora_web2
READ_ONLY_WEB3_DATABASE_URL_DEV=postgres://agora:agora@postgres:5432/agora_web3

# --- DAO Node (Task 3) ---
# getDaoNodeURLForNamespace() does url.replace("{TENANT_NAMESPACE}", namespace);
# a template with no such placeholder is returned unchanged, so a single
# DAO Node instance works fine here.
DAONODE_URL_TEMPLATE=http://dao-node:8000

# --- Archive (CPLS, Task 4) ---
# vendor/agora-next/src/lib/constants.ts's ARCHIVE_GCS_BUCKET constant
# reads ONLY ARCHIVE_GCS_BUCKET_OVERRIDE from the environment; there is no
# plain "which bucket name" env var (the constant's own name is a false
# friend). Unset, it hardcodes a real, unrelated Agora production bucket
# (https://storage.googleapis.com/cpls-usmr-dev-test-26q1), which would
# silently read the wrong DAO's data instead of fleet's. So, unlike the
# brief's original framing ("set ARCHIVE_GCS_BUCKET_OVERRIDE only in the
# offline overlay, the way Task 4 did for CPLS's STORAGE_EMULATOR_HOST"),
# this var must be set here too, pointed at the real bucket CPLS's own
# GCS_BUCKET_NAME writes to; only the offline overlay changes which base
# URL it points at (fake-gcs instead of storage.googleapis.com). See
# docs/compatibility-notes.md, Task 5, "ARCHIVE_GCS_BUCKET is not a real
# env var" for the full writeup.
ARCHIVE_GCS_BUCKET_OVERRIDE=https://storage.googleapis.com/fleet-archive-dev

# --- Fleet contract deployment (Task 6) ---
# JSON written by Task 6's deployment script: { chainId, governor, token,
# timelock, ledger, hook, registry }. infra/agora-next/overlay's
# configs/contracts/fleet.ts reads this file fresh on every call (no
# module-scope caching), so replacing it and restarting the container
# (no rebuild needed) is enough to pick up a real deployment.
FLEET_DEPLOYMENT_FILE=/deployments/agora-next-deployment.json

# --- Auth ---
# README.md: "Minimum: 32 characters recommended". Dev-only value; do not
# reuse in a real deployment.
JWT_SECRET=dev-only-32-character-secret-key-fleet

# --- Left empty on purpose (verified the app still boots without them) ---
# WalletConnect: injected-only wallets (e.g. an extension wallet) still
# work without a WalletConnect project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Alchemy smart accounts (modular accounts): not used by this tenant.
NEXT_PUBLIC_ALCHEMY_SMART_ACCOUNT=
# EAS (Ethereum Attestation Service) attestations: not used by this tenant.
EAS_SENDER_PRIVATE_KEY=
# Pinata (IPFS pinning): not used by this tenant.
PINATA_JWT=
# Tenderly (simulation): not used by this tenant.
TENDERLY_ACCESS_KEY=
TENDERLY_USER=
TENDERLY_PROJECT=
