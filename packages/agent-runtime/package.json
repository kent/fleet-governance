{
  "name": "@fleet/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/ && mkdir -p dist/providers/prompts && cp src/providers/prompts/*.md dist/providers/prompts/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fleet/gateway": "workspace:*",
    "@fleet/schemas": "workspace:*",
    "@fleet/sdk": "workspace:*",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "viem": "2.56.5",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
