{
  "name": "@fleet/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "FLEET_INTEGRATION=1 vitest run --project integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fleet/abi": "workspace:*",
    "@fleet/schemas": "workspace:*",
    "viem": "2.56.5"
  }
}
